#  ~/.config/fastfetch/config.jsonc
# Style inspired by your screenshot (Software / Hardware sections)

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/logo.png",
        "height": 16,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 2
        }
    },

    "display": {
        "separator": " : ",
        "color": {
            "keys": "white",
            "title": "magenta"
        },
        "key": {
            "width": 8
        }
    },

    "modules": [
        // ========== SOFTWARE ==========
        {
            "type": "custom",
            "format": "{#1}{#magenta}Software{#}"
        },
        {
            "type": "title",
            "key": "{#magenta}󰀄 USR{#}",
            "format": "{user-name}"
        },
        {
            "type": "os",
            "key": "{#red}󰣇 OS{#}",
            "format": "{pretty-name} {arch}"
        },
        {
            "type": "kernel",
            "key": "{#green}󰒋 KERN{#}"
        },
        {
            "type": "wm",
            "key": "{#blue}󰖲 WM{#}",
            "format": "{pretty-name} ({protocol-name})"
        },
        {
            "type": "shell",
            "key": "{#magenta}󰆍 SH{#}"
        },
        {
            "type": "terminal",
            "key": "{#cyan}󰆍 TERM{#}"
        },

        "break",

        // ========== HARDWARE ==========
        {
            "type": "custom",
            "format": "{#1}{#blue}Hardware{#}"
        },
        {
            "type": "host",
            "key": "{#blue}󰌢 PC{#}"
        },
        {
            "type": "cpu",
            "key": "{#green}󰻠 CPU{#}",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "{#cyan}󰍛 GPU{#}",
            "format": "{name} @ {frequency} [{type}]"
        },
        {
            "type": "memory",
            "key": "{#magenta}󰍛 MEM{#}",
            "format": "{used} / {total} ({percentage}%)"
        },
        {
            "type": "disk",
            "key": "{#yellow}󰋊 SYS{#}",
            "folders": "/",
            "format": "{size-used} / {size-percentage} ({filesystem})"
        },

        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
